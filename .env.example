# ── Application ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=platform
DB_PASSWORD=platform_secret
DB_NAME=content_platform

# ── Vector database (Qdrant) ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── LLM providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

GOOGLE_AI_API_KEY=AIza...
GEMINI_DEFAULT_MODEL=gemini-1.5-pro

# ── Alibaba DashScope ─────────────────────────────────────────────────────────
# Dashboard: https://dashscope-intl.console.aliyun.com/
# Free tier: 1M tokens for new accounts (qwen-turbo, 180-day window)
DASHSCOPE_API_KEY=sk-...
ALIBABA_DEFAULT_MODEL=qwen-plus

# ── LLM router ────────────────────────────────────────────────────────────────
LLM_FALLBACK_CHAIN=claude,openai,gemini,alibaba
# Provider used for embeddings: openai | alibaba (DashScope text-embedding-v3)
EMBEDDING_PROVIDER=openai
# Dimension of embedding vectors. openai ada-002=1536, DashScope v3 max=1024
# WARNING: changing this requires clearing all Qdrant collections (docker-compose down -v)
EMBEDDING_DIMENSION=1536
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_MS=1000

# Circuit breaker — opens after N consecutive failures, resets after cooldown
LLM_CB_FAILURE_THRESHOLD=5
LLM_CB_COOLDOWN_MS=30000

# ── Queue (Redis / BullMQ) ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Resilience ────────────────────────────────────────────────────────────────
QUEUE_DEPTH_THRESHOLD=50
RAG_TIMEOUT_MS=5000
PIPELINE_LATENCY_BUDGET_MS=90000

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_SEARCH_LIMIT=5

# ── Streaming (SSE) ───────────────────────────────────────────────────────────
SSE_HEARTBEAT_INTERVAL_MS=15000
STREAM_MAX_DURATION_MS=300000

# ── Observability ─────────────────────────────────────────────────────────────
OTLP_ENDPOINT=http://localhost:4318/v1/traces
METRICS_ENABLED=true

# ── Evaluation ────────────────────────────────────────────────────────────────
MEMORY_INDEXING_THRESHOLD=0.70
